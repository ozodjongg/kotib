# https://my.telegram.org → API development tools
TG_APP_ID=
TG_APP_HASH=
# @BotFather
BOT_TOKEN=
# Mini App'ning HTTPS manzili (reverse proxy orqali)
MINIAPP_URL=https://secretary.example.com/
GEMINI_API_KEY=
# Model nomini Google AI Studio'dan aniq nusxalang
GEMINI_MODEL=
# openssl rand -base64 32   — session shifrlash kaliti. BAZADA SAQLANMAYDI, yo'qotsangiz sessiyalar ochilmaydi.
MASTER_KEY=
DATABASE_URL=postgres://user:pass@localhost:5432/secretary?sslmode=require

# --- To'lov (Telegram Stars) ---
# Oylik obuna narxi Stars'da (1–10000). 0 yoki bo'sh — to'lov o'chiq, xizmat bepul.
# PRICE_STARS=100
# Bepul sinov kunlari (default 7; 0 — sinovsiz)
# TRIAL_DAYS=7
# Admin Telegram ID'lari (vergul bilan): /stats va /refund buyruqlari; adminlar uchun kotib bepul.
# O'z ID'ingizni @userinfobot dan bilib olasiz.
# ADMIN_IDS=123456789
# docker-compose uchun:
# POSTGRES_PASSWORD=
# TG_PROXY=socks5://user:pass@host:1080
# LISTEN=127.0.0.1:8080   (berilmasa: PORT bo'lsa 0.0.0.0:$PORT, aks holda 127.0.0.1:8080)
# STATIC_DIR=./webapp
# DEV_MEMORY=1
